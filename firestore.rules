rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // Quem pede para ver é seguidor aceito do dono?
    function approvedBy(owner) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(owner)/followers/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(owner)/followers/$(request.auth.uid)).data.status == 'accepted';
    }
    // As duas pessoas estão conectadas? (eu sigo a outra, ou ela me segue, com pedido aceito)
    function connectedWith(other) {
      return approvedBy(other)
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid)/followers/$(other))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)/followers/$(other)).data.status == 'accepted');
    }
    function onlyStatusToAccepted() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
    }

    // Reserva de nomes de usuário (garante que cada @ é único)
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9._]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Perfil público (nome e @) — qualquer pessoa logada pode ver e buscar
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid)
        && request.resource.data.username is string
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;
      allow delete: if false;

      // Livros: só a dona e seguidores aceitos leem; só a dona escreve
      match /books/{bookId} {
        allow read: if isMe(uid) || approvedBy(uid);
        allow write: if isMe(uid);

        // Curtidas no livro e no comentário: o id do documento é o uid de quem curtiu
        match /likes/{lid} {
          allow read: if isMe(uid) || approvedBy(uid);
          allow create: if (isMe(uid) || approvedBy(uid)) && lid == request.auth.uid;
          allow delete: if signedIn() && (lid == request.auth.uid || isMe(uid));
        }
        match /commentLikes/{lid} {
          allow read: if isMe(uid) || approvedBy(uid);
          allow create: if (isMe(uid) || approvedBy(uid)) && lid == request.auth.uid;
          allow delete: if signedIn() && (lid == request.auth.uid || isMe(uid));
        }
        // Respostas: a dona e os seguidores aceitos escrevem; quem escreveu ou a dona apagam
        match /replies/{rid} {
          allow read: if isMe(uid) || approvedBy(uid);
          allow create: if (isMe(uid) || approvedBy(uid))
            && request.resource.data.author == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000;
          allow delete: if signedIn() && (resource.data.author == request.auth.uid || isMe(uid));
        }
      }

      // Sugestões de livros recebidas por {uid}: só quem se segue pode enviar
      match /suggestions/{sid} {
        allow read, delete: if isMe(uid);
        allow create: if signedIn() && !isMe(uid)
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.title is string && request.resource.data.title.size() <= 300
          && request.resource.data.note is string && request.resource.data.note.size() <= 500
          && connectedWith(uid);
      }

      // Seguidores de {uid}. O id do documento é o uid de quem segue.
      match /followers/{fid} {
        allow read: if signedIn();
        allow create: if isMe(fid) && request.resource.data.status == 'pending';
        allow update: if isMe(uid) && onlyStatusToAccepted();
        allow delete: if isMe(uid) || isMe(fid);
      }

      // Quem {uid} segue. O id do documento é o uid da pessoa seguida.
      match /following/{tid} {
        allow read: if signedIn();
        allow create: if isMe(uid) && request.resource.data.status == 'pending';
        allow update: if isMe(tid) && onlyStatusToAccepted();
        allow delete: if isMe(uid) || isMe(tid);
      }
    }
  }
}
